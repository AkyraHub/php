{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": ["dependencies", "renovate"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group all non-major (minor + patch) bumps into a single weekly PR",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major bumps",
      "groupSlug": "non-major"
    },
    {
      "description": "Open separate PRs for major bumps (manual review)",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "renovate", "major"]
    },
    {
      "description": "Group all GitHub Actions versions into one weekly PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions",
      "groupSlug": "gh-actions"
    },
    {
      "description": "Auto-merge digest pins and patch bumps after CI green",
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": false
    }
  ],
  "regexManagers": [
    {
      "description": "Pin Alpine apk packages in Dockerfile (pkg=~X.Y syntax)",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "(?<depName>[a-zA-Z0-9._-]+)=~(?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "registryUrlTemplate": "https://repology.org/api/v1/project/{{depName}}/alpine_3_23"
    },
    {
      "description": "PECL packages (pecl install pkg-X.Y.Z)",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "pecl install (?<depName>[a-zA-Z0-9_-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pecl",
      "versioningTemplate": "semver"
    },
    {
      "description": "php-fpm-healthcheck URL pinned to a release tag",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "renatomefi/php-fpm-healthcheck/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "renatomefi/php-fpm-healthcheck",
      "versioningTemplate": "semver"
    },
    {
      "description": "Base PHP image ARG (PHP_VERSION + ALPINE_VERSION)",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "ARG PHP_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "php",
      "versioningTemplate": "docker"
    }
  ]
}
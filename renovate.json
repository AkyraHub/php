{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": ["dependencies", "renovate"],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group all non-major (minor + patch) bumps into a single weekly PR",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major bumps",
      "groupSlug": "non-major"
    },
    {
      "description": "Open separate PRs for major bumps (manual review)",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "renovate", "major"]
    },
    {
      "description": "Group all GitHub Actions versions into one weekly PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions",
      "groupSlug": "gh-actions"
    },
    {
      "description": "Auto-merge digest pins and patch bumps after CI green",
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin Alpine apk packages in Dockerfile (pkg=X.Y.Z-rN syntax)",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["(?<depName>[a-zA-Z0-9._-]+)=(?<currentValue>\\d[\\w.]*-r\\d+)"],
      "datasourceTemplate": "repology",
      "versioningTemplate": "loose",
      "packageNameTemplate": "alpine_3_23/{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "PECL packages (pecl install pkg-X.Y.Z)",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["pecl install (?<depName>[a-zA-Z0-9_-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "pecl",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "php-fpm-healthcheck URL pinned to a release tag",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["renatomefi/php-fpm-healthcheck/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "renatomefi/php-fpm-healthcheck",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Base PHP image ARG (PHP_VERSION + ALPINE_VERSION)",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG PHP_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "php",
      "versioningTemplate": "docker"
    }
  ]
}
